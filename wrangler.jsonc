{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qodlume",
	"main": "cloudflare-worker.ts",
	"compatibility_date": "2026-10-21",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "qodlume",
			"database_id": "e4938352-b62d-4420-8dee-a62d82f3a81b",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}